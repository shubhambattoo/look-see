{
  "name": "@shubhambattoo/look-see",
  "version": "0.4.0",
  "description": "Look-See scans dependencies for known vulnerabilities",
  "author": "shubhambattoo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhambattoo/look-see.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "look-see": "./bin/look-see.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "start": "node ./bin/look-see.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@yarnpkg/lockfile": "^1.1.0",
    "chalk": "^6.0.1",
    "yaml": "^2.8.1"
  },
  "license": "MIT",
  "keywords": [
    "dependency-audit",
    "vulnerability-scanner",
    "security",
    "osv",
    "nvd",
    "cve-now"
  ],
  "publishConfig": {
    "access": "public"
  }
}
